# Copy to .env for local overrides. All values below are the defaults.

# Port the API/server listens on.
PORT=8787

# Set to "production" when serving the built client from the Node server.
# NODE_ENV=production

# --- Database (libSQL / Turso) ------------------------------------------
# Development default: a local SQLite file at ./data/mindfultasks.db
# Production: point at a Turso database.
#   DATABASE_URL=libsql://your-db-name.turso.io
#   DATABASE_AUTH_TOKEN=eyJ...            # from `turso db tokens create`
#
# You can also force a local file explicitly:
#   DATABASE_URL=file:./data/mindfultasks.db

# Dev only: where Vite proxies /api requests (defaults to http://localhost:8787).
# VITE_API_TARGET=http://localhost:8787
